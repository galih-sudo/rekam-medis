generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pasien {
  id         Int         @id @default(autoincrement())
  no_rm      String      @unique
  nama       String
  no_hp      String
  alamat     String
  created_at DateTime    @default(now())
  kunjungan  Kunjungan[]
}

model Kunjungan {
  id         Int      @id @default(autoincrement())
  pasienId   Int
  pasien     Pasien   @relation(fields: [pasienId], references: [id])
  tanggal    DateTime @default(now())
  keluhan    String
  diagnosa   String
  terapi     String
  obat       String
  created_at DateTime @default(now())
}
