generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model pasien {
  id         Int      @id @default(autoincrement())
  no_rm      String   @unique
  nama       String
  no_hp      String?
  alamat     String?
  created_at DateTime @default(now())
}
